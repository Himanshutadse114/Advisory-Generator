# Advisory Generator AI service

# Primary provider for the reference-guided AI advisory generator.
# Add this in Render Environment Variables. Never expose it to the browser.
REPLICATE_API_TOKEN=
REPLICATE_TEXT_MODEL=meta/meta-llama-3-8b-instruct
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro

# Admin access for provider status and optional Gemini settings.
# Use at least 12 characters. For production use a long unique password.
ADMIN_PASSWORD=

# Optional separate encryption secret for runtime Gemini keys.
# If omitted, ADMIN_PASSWORD is used to derive the encryption key.
ADMIN_ENCRYPTION_SECRET=

# Optional persistent data directory for encrypted runtime secrets.
ADVISORY_DATA_DIR=

# Optional Gemini / Vertex fallback for the classic structured editor.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Local API port used by the Vite development proxy.
ADVISORY_API_PORT=8787

# Optional: point the browser at a separately hosted classic AI endpoint.
# VITE_ADVISORY_AI_ENDPOINT=https://example.com/api/advisories/generate
