# Advisory Generator AI service
#
# Admin access for managing Gemini credentials from the UI.
# Use at least 12 characters. For production use a long unique password.
ADMIN_PASSWORD=

# Optional separate encryption secret for runtime API keys.
# If omitted, ADMIN_PASSWORD is used to derive the encryption key.
ADMIN_ENCRYPTION_SECRET=

# Optional persistent data directory for encrypted runtime secrets.
# On Render or similar hosts, point this at a persistent disk mount.
ADVISORY_DATA_DIR=

# Option A — Vertex AI with Application Default Credentials / service account.
# Set GOOGLE_APPLICATION_CREDENTIALS in the runtime to the path of the service-account JSON file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# Option B — Gemini Developer API key fallback.
# This is no longer required if the key is added through the Admin panel.
GEMINI_API_KEY=

# Default models used when no runtime admin override is stored.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Local API port used by the Vite development proxy.
ADVISORY_API_PORT=8787

# Optional: point the browser at a separately hosted API.
# VITE_ADVISORY_AI_ENDPOINT=https://example.com/api/advisories/generate
